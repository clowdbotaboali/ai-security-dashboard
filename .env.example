# ═══════════════════════════════════════════
#  LLM Jailbreak Testing Dashboard - Configuration
# ═══════════════════════════════════════════

# Flask
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=8765

# Database
DATABASE_PATH=jailbreak_results.db

# CORS — comma-separated origins (default: localhost only)
# Use * ONLY for development, restrict in production
ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765

# ═══════════════════════════════════════════
#  API Keys (REQUIRED — never commit these!)
# ═══════════════════════════════════════════

# OpenRouter API key — used server-side only (never sent to frontend)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Dashboard auth — protects all endpoints (leave empty to disable auth in dev)
DASHBOARD_API_KEY=your_dashboard_password_here
